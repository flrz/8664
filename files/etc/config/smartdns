config smartdns
	option enabled '0'
	option server_name 'smartdns'
	option port '6053'
	option tcp_server '1'
	option ipv6_server '1'
	option dualstack_ip_selection '1'
	option prefetch_domain '1'
	option serve_expired '1'
	option cache_size '20000'
	option rr_ttl_min '300'

# ===== 必须添加至少一个上游 DNS，否则无法解析域名 =====
config server
	option enabled '1'
	option name 'DNSPod'
	option ip '119.29.29.29'
	option type 'udp'

config server
	option enabled '1'
	option name 'AliDNS'
	option ip '223.5.5.5'
	option type 'udp'
