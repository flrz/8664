
# ============================================================
# OpenWrt 24.10 x86_64 Hardened Final Edition (Improved)
# Target: x86_64 Generic (Proxmox VE / KVM / ESXi / Industrial PC)
# ============================================================

# ------------------------------------------------------------
# Target Platform & Disk Partition
# ------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# VM Images Output
CONFIG_VMDK_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_VDI_IMAGES=y
CONFIG_VHD_IMAGES=y
CONFIG_ISO_IMAGES=y

# ------------------------------------------------------------
# Build Optimization
# ------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=x86-64"

# ------------------------------------------------------------
# Memory Tuning / ZRAM / Swap Support
# ------------------------------------------------------------
CONFIG_KERNEL_SWAP=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_swap-utils=y

# ------------------------------------------------------------
# LuCI Base & UI & Localization (简体中文集成)
# ------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# LuCI 核心与常见组件中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# Themes (Argon Integrated + 中文支持)
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ------------------------------------------------------------
# RPC / Web / Ucode Backend (OpenWrt 24.10)
# ------------------------------------------------------------
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-math=y

# ------------------------------------------------------------
# Time Synchronization & Zone Support (北京时间同步)
# ------------------------------------------------------------
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_ntpd=y
CONFIG_PACKAGE_ntp-utils=y

# ------------------------------------------------------------
# SSL & Security Core
# ------------------------------------------------------------
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl-util=y

# SSH (Dropbear)
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dropbearconvert=y

# Security & Log Management
CONFIG_PACKAGE_fail2ban=y
CONFIG_PACKAGE_logrotate=y

# ------------------------------------------------------------
# Firewall4 / nftables (OpenWrt 24.10 Native)
# ------------------------------------------------------------
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_conntrack-tools=y

# ------------------------------------------------------------
# Linux Networking Core & BBR
# ------------------------------------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-sit=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ------------------------------------------------------------
# NIC Drivers (Intel / Realtek / VirtIO)
# ------------------------------------------------------------
CONFIG_PACKAGE_kmod-igc=y          # Intel i225/i226 2.5G
CONFIG_PACKAGE_kmod-e1000e=y       # Intel Gigabit
CONFIG_PACKAGE_kmod-ixgbe=y        # Intel 10G
CONFIG_PACKAGE_kmod-r8169=y        # Realtek 1G/2.5G
CONFIG_PACKAGE_kmod-virtio-net=y   # VirtIO Net

# ------------------------------------------------------------
# Virtualization / Proxmox VE / KVM / ESXi
# ------------------------------------------------------------
CONFIG_PACKAGE_kmod-virtio=y
CONFIG_PACKAGE_kmod-virtio-pci=y
CONFIG_PACKAGE_kmod-vhost=y
CONFIG_PACKAGE_kmod-vhost-net=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-scsi-generic=y
CONFIG_PACKAGE_kmod-virtio-balloon=y
CONFIG_PACKAGE_kmod-virtio-rng=y
CONFIG_PACKAGE_qemu-ga=y            # QEMU Guest Agent

# ------------------------------------------------------------
# PassWall & Proxy (Pure Nftables Mode + 中文包)
# ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_chinadns-ng=y

# ------------------------------------------------------------
# VPN & Tunneling
# ------------------------------------------------------------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_openvpn-mbedtls=y
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_luci-i18n-openvpn-zh-cn=y

# ------------------------------------------------------------
# DNS Resolution & AdGuardHome
# ------------------------------------------------------------
# Deselect default dnsmasq to avoid conflict with dnsmasq-full
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# AdGuardHome + 中文包
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# ------------------------------------------------------------
# QoS & Traffic Shaping (CAKE / SQM + 中文包)
# ------------------------------------------------------------
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ------------------------------------------------------------
# Storage, Filesystem & Disk Maintenance
# ------------------------------------------------------------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_hdparm=y

# ------------------------------------------------------------
# Industrial Hardware & USB Serial Support
# ------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y

# Hardware Monitoring / Sensors
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# Serial Console Tools
CONFIG_PACKAGE_minicom=y
CONFIG_PACKAGE_picocom=y

# Hardware Watchdog
CONFIG_PACKAGE_watchdog=y
CONFIG_PACKAGE_watchcat=y

# ------------------------------------------------------------
# Utilities & Diagnostic Tools
# ------------------------------------------------------------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_irqbalance=y

CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_zstd=y
CONFIG_PACKAGE_lz4=y

# Networking Diagnostic
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_netcat=y
CONFIG_PACKAGE_socat=y

# System Upgrade
CONFIG_PACKAGE_attendedsysupgrade=y

# Monitoring (Collectd)
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-df=y
CONFIG_PACKAGE_collectd-mod-disk=y
